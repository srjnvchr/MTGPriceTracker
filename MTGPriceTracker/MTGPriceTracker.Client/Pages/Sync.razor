@page "/sync"
@inject ApiService Api
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Data Sync — MTG Price Tracker</PageTitle>

<MudText Typo="Typo.h5" Class="mb-6" Style="font-weight:600;">
    <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2" />
    Data Sync
</MudText>

@if (_apiError)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Cannot reach the server. Is the backend running? Retrying every 3 seconds...
    </MudAlert>
}

<!-- Status cards — always visible -->
<MudGrid Spacing="4" Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="background:var(--mud-palette-surface); border-radius:12px;">
            <MudText Typo="Typo.h4" Style="color:var(--mud-palette-primary); font-weight:700;">
                @_status.TotalCards.ToString("N0")
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">CARDS IN DATABASE</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="background:var(--mud-palette-surface); border-radius:12px;">
            <MudText Typo="Typo.h4" Style="color:var(--mud-palette-secondary); font-weight:700;">
                @_status.TotalPriceSnapshots.ToString("N0")
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">PRICE RECORDS</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="background:var(--mud-palette-surface); border-radius:12px;">
            <MudText Typo="Typo.h6" Style="@(_status.IsRunning ? "color:#ffa726; font-weight:600;" : "color:#66bb6a; font-weight:600;")">
                @(_status.IsRunning ? "⏳ Running" : "✅ Idle")
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">STATUS</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="2" Class="pa-4 text-center" Style="background:var(--mud-palette-surface); border-radius:12px;">
            <MudText Typo="Typo.body2" Style="color:#81c784; font-weight:600;">
                @(_status.LastSyncAt.HasValue
                    ? _status.LastSyncAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    : "Never")
            </MudText>
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">LAST SYNC</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_status.IsRunning && !string.IsNullOrWhiteSpace(_status.CurrentOperation))
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <div class="d-flex align-center gap-2">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            <MudText>@_status.CurrentOperation</MudText>
        </div>
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(_status.LastSyncResult))
{
    <MudAlert Severity="@(_status.LastSyncResult.StartsWith("Error") ? Severity.Error : Severity.Success)" Class="mb-6">
        @_status.LastSyncResult
    </MudAlert>
}

<!-- Actions -->
<MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">Sync Actions</MudText>
<MudGrid Spacing="3">

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-5" Style="background:var(--mud-palette-surface); border-radius:12px; height:100%;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Download" Color="Color.Primary" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight:600;">Import Card Catalog</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:rgba(255,255,255,0.6);">
                Downloads and imports all MTG card data from MTGJSON (AllPrintings.json).
                This is a <strong>one-time setup</strong> that takes 3–10 minutes.
                Run again when new sets are released.
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4" Style="color:rgba(255,255,255,0.4);">
                Source: mtgjson.com/api/v5/AllPrintings.json.gz
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="ImportCatalog"
                       Disabled="_status.IsRunning"
                       StartIcon="@Icons.Material.Filled.CloudDownload"
                       FullWidth="true">
                Import Card Catalog
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-5" Style="background:var(--mud-palette-surface); border-radius:12px; height:100%;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Secondary" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight:600;">Sync Prices</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:rgba(255,255,255,0.6);">
                Downloads latest prices from MTGJSON (TCGPlayer, Card Kingdom, CardMarket)
                and scrapes Good Games AU. Runs automatically daily at 1:00 AM AEST.
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4" Style="color:rgba(255,255,255,0.4);">
                Source: mtgjson.com + goodgames.com.au
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       OnClick="TriggerSync"
                       Disabled="_status.IsRunning || _status.TotalCards == 0"
                       StartIcon="@Icons.Material.Filled.Sync"
                       FullWidth="true">
                Sync Prices Now
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-5" Style="background:var(--mud-palette-surface); border-radius:12px; height:100%;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Tertiary" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight:600;">Sync Good Games Prices</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:rgba(255,255,255,0.6);">
                Scrapes Near Mint prices from Good Games AU and stores them against the correct
                card UUID. Always runs immediately, bypassing the once-per-day guard.
                Use this after fixing matching logic or to force a re-scrape on the same day.
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4" Style="color:rgba(255,255,255,0.4);">
                Source: tcg.goodgames.com.au
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                       OnClick="TriggerGoodGamesSync"
                       Disabled="_status.IsRunning || _status.TotalCards == 0"
                       StartIcon="@Icons.Material.Filled.Storefront"
                       FullWidth="true">
                Sync Good Games Now
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-5" Style="background:var(--mud-palette-surface); border-radius:12px; border: 1px solid rgba(239,83,80,0.3); height:100%;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Style="color:#ef5350;" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight:600;">Clear Good Games Prices</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:rgba(255,255,255,0.6);">
                Deletes <strong>all</strong> stored Good Games price rows from the database.
                Use this to remove stale or incorrectly-matched prices before re-scraping.
                After clearing, run <em>Sync Good Games Now</em> to rebuild with correct UUIDs.
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4" Style="color:rgba(255,255,255,0.35);">
                This cannot be undone. MTGJSON vendor prices are not affected.
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Style="border-color:#ef5350; color:#ef5350;"
                       OnClick="ClearGoodGamesPrices"
                       Disabled="_clearing"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       FullWidth="true">
                @(_clearing ? "Clearing…" : "Clear Good Games Prices")
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-5" Style="background:var(--mud-palette-surface); border-radius:12px; height:100%;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Warning" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight:600;">Import 90-Day Price History</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:rgba(255,255,255,0.6);">
                Downloads the full AllPrices.json (~150 MB compressed) and backfills 90 days of
                retail price history for all cards. <strong>One-time operation</strong> — skips automatically
                if history already exists. Takes 10–20 minutes. Requires ~1 GB free disk space temporarily.
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4" Style="color:rgba(255,255,255,0.4);">
                Source: mtgjson.com/api/v5/AllPrices.json.gz
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       OnClick="ImportHistory"
                       Disabled="_status.IsRunning || _status.TotalCards == 0"
                       StartIcon="@Icons.Material.Filled.CloudDownload"
                       FullWidth="true">
                Import Price History
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-5" Style="background:var(--mud-palette-surface); border-radius:12px; border: 1px solid rgba(88,101,242,0.4); height:100%;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="color:#7289DA;" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight:600;">Discord Price Alerts</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:rgba(255,255,255,0.6);">
                Scans the last 7 days of TCGPlayer retail prices and sends a Discord notification
                for every card that jumped <strong>10%+</strong> and is currently worth <strong>≥$3</strong>.
                Cards are colour-coded by spike size (gold · orange · red).
            </MudText>
            <MudText Typo="Typo.caption" Class="mb-4" Style="color:rgba(255,255,255,0.4);">
                Vendor: TCGPlayer · NM Retail (USD)
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background:#5865F2; color:#fff;"
                       OnClick="TriggerDiscordAlerts"
                       Disabled="_alertsRunning || _status.TotalCards == 0"
                       StartIcon="@Icons.Material.Filled.Send"
                       FullWidth="true">
                @(_alertsRunning ? "Checking prices…" : "Send Price Alerts")
            </MudButton>

            @if (_lastAlertResult is not null)
            {
                <MudAlert Severity="@(_lastAlertResult.Success ? Severity.Success : Severity.Error)"
                          Class="mt-3" Dense="true">
                    @_lastAlertResult.Message
                </MudAlert>

                @if (_lastAlertResult.Success && _lastAlertResult.AlertCount > 0)
                {
                    <MudSimpleTable Dense="true" Class="mt-3" Style="background:transparent;">
                        <thead>
                            <tr>
                                <th style="color:rgba(255,255,255,0.5); font-size:0.7rem;">Card</th>
                                <th style="color:rgba(255,255,255,0.5); font-size:0.7rem; text-align:right;">Was</th>
                                <th style="color:rgba(255,255,255,0.5); font-size:0.7rem; text-align:right;">Now</th>
                                <th style="color:rgba(255,255,255,0.5); font-size:0.7rem; text-align:right;">Change</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in _lastAlertResult.Alerts.Take(10))
                            {
                                <tr>
                                    <td style="font-size:0.75rem;">@alert.CardName <span style="color:rgba(255,255,255,0.35);">[@alert.SetCode]</span></td>
                                    <td style="font-size:0.75rem; text-align:right; color:rgba(255,255,255,0.5);">$@alert.OldPrice.ToString("F2")</td>
                                    <td style="font-size:0.75rem; text-align:right;">$@alert.NewPrice.ToString("F2")</td>
                                    <td style="font-size:0.75rem; text-align:right; color:@AlertColor(alert.ChangePercent); font-weight:600;">+@alert.ChangePercent.ToString("F1")%</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @if (_lastAlertResult.AlertCount > 10)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1" Style="color:rgba(255,255,255,0.35);">
                            +@(_lastAlertResult.AlertCount - 10) more sent to Discord
                        </MudText>
                    }
                }
            }
        </MudPaper>
    </MudItem>

</MudGrid>

<MudText Typo="Typo.caption" Class="mt-6" Style="color:rgba(255,255,255,0.3);">
    Note: Automatic price sync runs daily at 1:00 AM AEST. Good Games scraper is rate-limited to 1 request/second.
</MudText>

@code {

    private SyncStatusDto _status = new();
    private System.Threading.Timer? _pollTimer;
    private bool _apiError;
    private bool _clearing;
    private bool _alertsRunning;
    private PriceAlertResultDto? _lastAlertResult;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
        // Poll every 3 seconds to keep tiles live
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            await RefreshStatusAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            var result = await Api.GetSyncStatusAsync();
            if (result is not null)
            {
                _status = result;
                _apiError = false;
            }
        }
        catch
        {
            _apiError = true;
        }
    }

    private async Task ImportCatalog()
    {
        var result = await Api.TriggerCatalogImportAsync();
        if (result?.Success == true)
            Snackbar.Add(result.Message, Severity.Info);
        else
            Snackbar.Add(result?.Message ?? "Failed to trigger import", Severity.Warning);
        await RefreshStatusAsync();
    }

    private async Task ImportHistory()
    {
        var result = await Api.TriggerHistoryImportAsync();
        if (result?.Success == true)
            Snackbar.Add(result.Message, Severity.Info);
        else
            Snackbar.Add(result?.Message ?? "Failed to trigger history import", Severity.Warning);
        await RefreshStatusAsync();
    }

    private async Task TriggerSync()
    {
        var result = await Api.TriggerSyncAsync();
        if (result?.Success == true)
            Snackbar.Add(result.Message, Severity.Success);
        else
            Snackbar.Add(result?.Message ?? "Failed to trigger sync", Severity.Warning);
        await RefreshStatusAsync();
    }

    private async Task TriggerGoodGamesSync()
    {
        var result = await Api.TriggerGoodGamesSyncAsync();
        if (result?.Success == true)
            Snackbar.Add(result.Message, Severity.Info);
        else
            Snackbar.Add(result?.Message ?? "Failed to trigger Good Games sync", Severity.Warning);
        await RefreshStatusAsync();
    }

    private async Task ClearGoodGamesPrices()
    {
        _clearing = true;
        try
        {
            var result = await Api.ClearVendorPricesAsync("goodgames");
            if (result?.Success == true)
                Snackbar.Add(result.Message, Severity.Success);
            else
                Snackbar.Add(result?.Message ?? "Failed to clear prices", Severity.Error);
            await RefreshStatusAsync();
        }
        finally
        {
            _clearing = false;
        }
    }

    private async Task TriggerDiscordAlerts()
    {
        _alertsRunning = true;
        _lastAlertResult = null;
        try
        {
            _lastAlertResult = await Api.TriggerDiscordPriceAlertsAsync();
            if (_lastAlertResult?.Success == true)
                Snackbar.Add(_lastAlertResult.Message, Severity.Success);
            else
                Snackbar.Add(_lastAlertResult?.Message ?? "Failed to send alerts", Severity.Warning);
        }
        catch
        {
            Snackbar.Add("Error contacting the server.", Severity.Error);
        }
        finally
        {
            _alertsRunning = false;
        }
    }

    private static string AlertColor(decimal pct) => pct switch
    {
        >= 50m => "#FF4500",
        >= 25m => "#FF8C00",
        _      => "#FFD700"
    };

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}