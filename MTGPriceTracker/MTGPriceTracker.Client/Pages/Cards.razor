@page "/cards"
@inject ApiService Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Cards — MTG Price Tracker</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:600;">All Cards</MudText>

<!-- Filters bar -->
<MudPaper Elevation="2" Class="pa-4 mb-4" Style="background:var(--mud-palette-surface);">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_query.Query"
                          Label="Search by name"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="false"
                          DebounceInterval="300"
                          OnDebounceIntervalElapsed="@((string _) => ResetAndLoad())" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudSelect Value="_query.Rarity" Label="Rarity" Variant="Variant.Outlined"
                       Clearable="true"
                       ValueChanged="@((string? v) => { _query.Rarity = v; _ = ResetAndLoad(); })">
                <MudSelectItem Value="@("common")">Common</MudSelectItem>
                <MudSelectItem Value="@("uncommon")">Uncommon</MudSelectItem>
                <MudSelectItem Value="@("rare")">Rare</MudSelectItem>
                <MudSelectItem Value="@("mythic")">Mythic</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudSelect Value="_query.SortBy" Label="Sort by" Variant="Variant.Outlined"
                       ValueChanged="@((string v) => { _query.SortBy = v; _ = ResetAndLoad(); })">
                <MudSelectItem Value="@("name")">Name</MudSelectItem>
                <MudSelectItem Value="@("set")">Set</MudSelectItem>
                <MudSelectItem Value="@("rarity")">Rarity</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudCheckBox Value="_query.SortDescending" Label="Descending"
                         Color="Color.Primary" Class="mt-2"
                         ValueChanged="@((bool v) => { _query.SortDescending = v; _ = ResetAndLoad(); })" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudCheckBox Value="_favoritesOnly" Label="Favorites only"
                         Color="Color.Secondary" Class="mt-2"
                         ValueChanged="@((bool v) => OnFavoritesOnlyChanged(v))" />
        </MudItem>
    </MudGrid>
</MudPaper>

<!-- Results info -->
@if (_totalCount > 0)
{
    <MudText Typo="Typo.caption" Class="mb-3" Style="color:rgba(255,255,255,0.5);">
        Showing @_cards.Count of @_totalCount.ToString("N0") cards
    </MudText>
}

<!-- Card grid with virtualization -->
@if (_loading && _cards.Count == 0)
{
    <div class="d-flex justify-center mt-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_cards.Count == 0 && !_loading)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        No cards found. @(string.IsNullOrWhiteSpace(_query.Query) ? "Try importing the card catalog first." : "Try a different search term.")
    </MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var card in _cards)
        {
            <MudItem xs="12" sm="6" md="4" lg="3" xl="2">
                <CardGridItem Card="card" OnFavoriteToggled="HandleFavoriteToggled" />
            </MudItem>
        }
    </MudGrid>

    <!-- Load more / infinite scroll trigger -->
    @if (_hasMore)
    {
        <div class="d-flex justify-center mt-6">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       OnClick="LoadMore" Disabled="_loading"
                       StartIcon="@(_loading ? null : Icons.Material.Filled.ExpandMore)">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>Loading...</text>
                }
                else
                {
                    <text>Load More (@(_totalCount - _cards.Count) remaining)</text>
                }
            </MudButton>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? Query { get; set; }

    private readonly CardSearchQuery _query = new() { PageSize = 24 };
    private bool _favoritesOnly;
    private List<CardDto> _cards = new();
    private int _totalCount;
    private bool _loading;
    private bool _hasMore;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Query))
            _query.Query = Query;

        await LoadCardsAsync(reset: true);
    }

    private async Task ResetAndLoad()
    {
        await LoadCardsAsync(reset: true);
    }

    private async Task OnFavoritesOnlyChanged(bool value)
    {
        _favoritesOnly = value;
        _query.FavoritesOnly = value ? true : null;
        await ResetAndLoad();
    }

    private async Task LoadMore()
    {
        _query.Page++;
        await LoadCardsAsync(reset: false);
    }

    private async Task LoadCardsAsync(bool reset)
    {
        if (reset)
        {
            _query.Page = 1;
            _cards.Clear();
        }

        _loading = true;
        StateHasChanged();

        try
        {
            var result = await Api.GetCardsAsync(_query);
            _cards.AddRange(result.Items);
            _totalCount = result.TotalCount;
            _hasMore = _cards.Count < _totalCount;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading cards: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleFavoriteToggled(CardDto card)
    {
        try
        {
            if (card.IsFavorite)
            {
                await Api.AddFavoriteAsync(card.Uuid);
                Snackbar.Add($"{card.Name} added to favorites", Severity.Success);
            }
            else
            {
                await Api.RemoveFavoriteAsync(card.Uuid);
                Snackbar.Add($"{card.Name} removed from favorites", Severity.Info);
            }

            if (_favoritesOnly)
                await ResetAndLoad();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating favorites: {ex.Message}", Severity.Error);
            card.IsFavorite = !card.IsFavorite; // revert
        }
    }
}