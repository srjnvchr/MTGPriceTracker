@inject NavigationManager Nav

<MudCard Class="card-grid-item" Style="cursor:pointer; background:var(--mud-palette-surface); border:1px solid rgba(255,255,255,0.08); transition: transform 0.15s ease, box-shadow 0.15s ease;"
         @onclick="NavigateToCard">

    <!-- Card image -->
    <div class="card-image-container" style="position:relative;">
        @if (Card.ImageUri != null)
        {
            <MudImage Src="@Card.ImageUri" Alt="@Card.Name" ObjectFit="ObjectFit.Cover"
                      Width="100" Height="140" Style="width:100%; height:200px; object-fit:cover;" />
        }
        else
        {
            <div style="width:100%; height:200px; background:linear-gradient(135deg,#1a1a3e,#2d1b4e); display:flex; align-items:center; justify-content:center;">
                <MudText Typo="Typo.h3" Style="opacity:0.3;">⚔️</MudText>
            </div>
        }

        <!-- Rarity badge -->
        <MudChip T="string" Size="Size.Small"
                 Style="@($"position:absolute; top:8px; left:8px; {GetRarityStyle(Card.Rarity)}")"
                 Text="@Card.Rarity.ToUpperInvariant()" />

        <!-- Favorite button -->
        <MudIconButton Icon="@(Card.IsFavorite ? Icons.Material.Filled.Favorite : Icons.Material.Outlined.FavoriteBorder)"
                       Color="@(Card.IsFavorite ? Color.Error : Color.Default)"
                       Size="Size.Small"
                       Style="position:absolute; top:4px; right:4px; background:rgba(0,0,0,0.6);"
                       OnClick="ToggleFavorite"
                       StopPropagation="true" />
    </div>

    <MudCardContent Class="pa-2">
        <MudText Typo="Typo.subtitle2" Style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
            @Card.Name
        </MudText>
        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.5);">
            @Card.SetCode — @Card.Type
        </MudText>

        <!-- Prices -->
        @if (Card.LatestPrices.Any())
        {
            <div class="mt-1">
                @foreach (var (key, price) in Card.LatestPrices.Take(2))
                {
                    var parts = key.Split('_');
                    var vendor = parts.Length > 0 ? parts[0] : key;
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.4);">
                            @GetVendorShortName(vendor)
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#81c784; font-weight:600;">
                            @FormatPrice(vendor, price)
                        </MudText>
                    </div>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.3);">No price data</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public CardDto Card { get; set; } = null!;
    [Parameter] public EventCallback<CardDto> OnFavoriteToggled { get; set; }

    private void NavigateToCard() => Nav.NavigateTo($"/cards/{Card.Uuid}");

    private async Task ToggleFavorite()
    {
        Card.IsFavorite = !Card.IsFavorite;
        await OnFavoriteToggled.InvokeAsync(Card);
    }

    private static string GetRarityStyle(string rarity) => rarity.ToLower() switch
    {
        "mythic" => "background:#bf360c; color:white;",
        "rare" => "background:#f9a825; color:black;",
        "uncommon" => "background:#546e7a; color:white;",
        _ => "background:#37474f; color:white;"
    };

    private static string GetVendorShortName(string vendor) => vendor switch
    {
        "tcgplayer" => "TCG",
        "cardkingdom" => "CK",
        "cardmarket" => "CM",
        "goodgames" => "GG",
        _ => vendor.ToUpperInvariant()[..Math.Min(3, vendor.Length)]
    };

    private static string FormatPrice(string vendor, decimal price)
    {
        var currency = vendor switch
        {
            "cardmarket" => "€",
            "goodgames" => "A$",
            _ => "$"
        };
        return currency;
    }
}
        