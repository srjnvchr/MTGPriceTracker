<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MTGPriceTracker.Server</RootNamespace>
    <UserSecretsId>3f706a62-1ab3-47f4-842c-556170cb54e5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core with SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Web scraping -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />

    <!-- API documentation -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Blazor WASM hosting -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTGPriceTracker.Client\MTGPriceTracker.Client.csproj" />
    <ProjectReference Include="..\MTGPriceTracker.Shared\MTGPriceTracker.Shared.csproj" />
  </ItemGroup>

</Project>
