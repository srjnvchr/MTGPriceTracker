<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MTGPriceTracker.Server</RootNamespace>
    <UserSecretsId>3f706a62-1ab3-47f4-842c-556170cb54e5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core with SQLite -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Web scraping -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />

    <!-- API documentation -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MTGPriceTracker.Shared\MTGPriceTracker.Shared.csproj" />
  </ItemGroup>

  <!--
    React frontend (MTGPriceTracker.Web). `dotnet publish` builds it with npm and ships the
    result in wwwroot/. Needs Node ^20.19 or >=22.12 on the machine that publishes.
    Skip the npm step and reuse an existing dist/ with:  dotnet publish -p:SkipWebBuild=true
  -->
  <PropertyGroup>
    <WebProjectDir>$(MSBuildProjectDirectory)/../MTGPriceTracker.Web/</WebProjectDir>
  </PropertyGroup>

  <Target Name="BuildReactApp" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(WebProjectDir)" Condition="'$(SkipWebBuild)' != 'true'" />
    <Exec Command="npm run build" WorkingDirectory="$(WebProjectDir)" Condition="'$(SkipWebBuild)' != 'true'" />

    <ItemGroup>
      <ReactDist Include="$(WebProjectDir)dist/**" />
      <ResolvedFileToPublish Include="@(ReactDist)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
